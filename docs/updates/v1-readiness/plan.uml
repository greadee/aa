@startuml
title v1 Scope & Composition — plan (decided)

skinparam shadowing false
skinparam defaultTextAlignment left

start

:Decide v1 definition of done (D1-D5);

partition "Surfaces (phase 10)" {
  :console: CLI + TUI + local web (in v1);
  :desktop (Wails/React): OUT of phase 10 -> v2;
}

partition "Control-plane server (D2)" {
  :home: app/ daemon exposing OpenAPI;
  :compose kernel + memory + toolbox + runtime;
  :auth: loopback bearer only (phase 11 for real authn);
}

partition "Composition coverage" {
  :in v1: scheduler/gate/planner, worker/intake,
   toolbox host, joblearn, inference, forge lifecycle+template,
   control-plane server;
  :v2: sync, obsv, visualizer, ui,
   registry teams/routines/policies, runtime/lifecycle;
}

partition "Release-readiness (phase 11)" {
  :threat model; perf/load; chaos/recovery;
  :packaging/install; versioning/tags/CHANGELOG;
  :docs; whole-repo revu audits (static-only); migration guides;
}

:deferred register -> issues;
:merge plan on dev;

stop

note right
  v1 review gate: revu static-only (D5).
  Desktop and sync/obsv/visualizer = v2.
end note

@enduml
