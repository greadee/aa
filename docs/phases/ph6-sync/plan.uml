@startuml
' Phase 6 — Sync: planned infrastructure. Authored at phase start.
' Copy to summary.uml at phase end and edit to the as-built state.

title Phase 6 — Sync (planned)

skinparam componentStyle rectangle

package "aa-sync (Go; imports contracts)" as sync {
  component "sync (types + errors + idempotency + clock)" as core
  component "identity (keys + pairing + mutual auth)" as identity
  component "transport (seam + deterministic in-memory fake)" as transport
  component "transfer (manifest + chunks + resume)" as transfer
  component "revision (one-way diff/apply + tombstones)" as revision
  component "queue (offline changes + reconcile)" as queue
  component "distribute (work packages + artifacts)" as distribute
  component "parallel (balanced assignment, no execution)" as parallel
  component "rpc (sync.distribute / fetchArtifact / status)" as rpc
}

package "aa-contracts (schemas + rpc-v1)" as contracts
package "aa-kernel (hosts the adapter, later)" as kernel
package "network / live transport (deferred)" as live

contracts --> rpc
core --> identity
identity --> transport
transport --> transfer
core --> revision
revision --> queue
transfer --> distribute
queue --> distribute
distribute --> parallel
distribute --> rpc
parallel --> rpc
live ..> transport : live adapter (deferred)
kernel ..> rpc : hosts over local socket

note right of identity
  ADR-P6-001/002: peer ID is the
  key fingerprint; pairing is a
  single-use token plus a mutual
  challenge-response.
end note

note bottom of transfer
  ADR-P6-004/005: content-addressed
  chunks; verify every chunk and the
  whole payload; resume from the
  receiver's received set.
end note

note bottom of queue
  ADR-P6-007: ordering derives from
  the record revision, never the
  wall clock.
end note

note bottom of parallel
  ADR-P6-009: coordination carries no
  execution authority and exposes no
  agent runtime.
end note

@enduml
