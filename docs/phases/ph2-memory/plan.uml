@startuml
' Phase 2 — Memory: planned infrastructure. Authored at phase start.
' Copy to summary.uml at phase end and edit to the as-built state.

title Phase 2 — Memory (planned)

skinparam componentStyle rectangle

package "aa-memory (depends on contracts, obsv)" as memory {
  component "facade (memory.go)" as facade
  package "store" as store {
    component "Record + hashing" as record
    component "portable layout (.aa-project)" as layout
    component "canonical store (records + events)" as canonical
  }
  package "projection" as projection {
    component "Projection interface" as piface
    component "in-memory reference" as pmem
    component "Rebuild + Digest" as rebuild
  }
  package "query" as query {
    component "deterministic queries" as q
    component "work/project/job histories" as hist
  }
  package "repo" as repo {
    component "issue repository" as issue
    component "strategy repository" as strategy
    component "promotion state machine" as promote
  }
}

package "aa-contracts" as contracts
package "consumers" as consumers {
  component "kernel (RPC/read)" as kernel
  component "visualizer (read)" as visualizer
  component "forge (sync)" as forge
  component "console (read)" as console
}

contracts --> memory
facade --> store
facade --> projection
facade --> repo
facade --> query
store --> record
store --> layout
store --> canonical
projection --> rebuild
projection --> pmem
projection --> piface
query --> hist
query --> q
repo --> issue
repo --> strategy
repo --> promote
promote --> record

memory --> kernel
memory --> visualizer
memory --> forge
memory --> console

note right of store
  .aa-project/
    manifest.json
    events.jsonl        (append-only)
    records/<kind>/<id>.json
    retention.json      (event floor)
end note

note bottom of projection
  Directory records are canonical.
  The projection is disposable and must
  rebuild to an identical digest.
  SQLite adapter deferred.
end note

note bottom of repo
  Lifecycle:
  EPHEMERAL -> CANDIDATE -> VALIDATED
  -> ACTIVE -> SUPERSEDED -> ARCHIVED
  Illegal transitions fail closed.
end note

@enduml
