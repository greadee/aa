# aa-sifter environment configuration.
#
# This is the LEGACY / override layer. Profiles are the primary configuration
# system (see `aa-sifter setup` and the config file at SIFTER_CONFIG).
#
# Precedence: CLI override > active profile > environment variables > defaults.
# When no profile file exists, these environment variables are authoritative.
# Once a profile file exists, the profile wins and mismatches are warned about.

# Where the profile file lives (default: ~/.aa_sifter/config.toml)
# SIFTER_CONFIG=~/.aa_sifter/config.toml

OLLAMA_HOST=http://localhost:11434

# Local tier (Ollama)
LOCAL_PROVIDER=ollama
LOCAL_MODEL=qwen3.5:9b
LOCAL_CONTEXT_LIMIT=64000
LOCAL_MAX_OUTPUT_TOKENS=4096
LOCAL_TEMPERATURE=0.2

# Expert tier (DeepSeek direct API by default)
EXPERT_PROVIDER=deepseek
EXPERT_ENDPOINT=https://api.deepseek.com/v1
EXPERT_API_KEY_ENV=DEEPSEEK_API_KEY
CLOUD_MODEL=deepseek-chat
CLOUD_CONTEXT_LIMIT=64000
CLOUD_INPUT_COST_PER_MTOK=0.14
CLOUD_OUTPUT_COST_PER_MTOK=0.28
EXPERT_MAX_OUTPUT_TOKENS=8192
EXPERT_TEMPERATURE=0.2
# DEEPSEEK_API_KEY=...   # never put real secrets in .env.example

ROUTING_POLICY=adaptive
CLOUD_ALLOWED=true
PREFER_LOCAL=true
COST_SENSITIVE=true
PRIVACY_SENSITIVE=true

LOCAL_CONFIDENCE_THRESHOLD=0.72
LOCAL_MAX_RETRIES=2

MAX_CLOUD_CALLS_PER_TASK=5
MAX_CLOUD_TOKENS_PER_TASK=200000
MAX_CLOUD_COST_PER_TASK=2.00
MAX_PARALLEL_CLOUD_CALLS=2
MAX_PARALLEL_LOCAL_CALLS=1

REQUEST_TIMEOUT_SECONDS=300

HUMAN_APPROVAL_FOR_MAJOR_DECISIONS=true
HUMAN_APPROVAL_FOR_CRITICAL_DECISIONS=true
HUMAN_APPROVAL_FOR_SIGNIFICANT_DECISIONS=false

# Non-interactive mode refuses major/critical decisions unless a standing rule
# explicitly grants them. Safe default for servers and aa-sync.
NON_INTERACTIVE=false

# Redact likely secrets before any cloud handoff.
REDACT_SECRETS=true

# Emit routing/decision traces.
DEBUG=false

DATABASE_PATH=~/.aa_sifter/aa_sifter.db
