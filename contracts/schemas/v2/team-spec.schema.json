{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/greadee/aa/contracts/schemas/v2/team-spec.schema.json",
  "title": "aa-team-spec",
  "x-contract-version": "2.0",
  "description": "A durable grouping of related roles for organization, policy, and performance analysis.",
  "type": "object",
  "required": ["contractVersion", "kind", "id", "title"],
  "properties": {
    "contractVersion": { "$ref": "common.schema.json#/$defs/contractVersion" },
    "kind": { "const": "team_spec" },
    "id": { "$ref": "common.schema.json#/$defs/identifier" },
    "projectId": { "$ref": "common.schema.json#/$defs/identifier" },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "revision": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "roles": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "maxItems": 256 }
  },
  "additionalProperties": true
}
