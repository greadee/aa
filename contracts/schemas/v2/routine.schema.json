{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/greadee/aa/contracts/schemas/v2/routine.schema.json",
  "title": "aa-routine",
  "x-contract-version": "2.0",
  "description": "An organization-owned, reusable specification for recurring work.",
  "type": "object",
  "required": ["contractVersion", "kind", "id", "name", "version", "stages"],
  "properties": {
    "contractVersion": { "$ref": "common.schema.json#/$defs/contractVersion" },
    "kind": { "const": "routine" },
    "id": { "$ref": "common.schema.json#/$defs/identifier" },
    "projectId": { "$ref": "common.schema.json#/$defs/identifier" },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "revision": { "type": "integer", "minimum": 0 },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "description": { "type": "string", "maxLength": 16384 },
    "teams": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "maxItems": 256 },
    "roles": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "maxItems": 256 },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/identifier" },
          "title": { "type": "string", "minLength": 1, "maxLength": 512 },
          "teams": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "maxItems": 256 },
          "roles": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" }, "maxItems": 256 },
          "gates": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "maxItems": 256 }
        },
        "additionalProperties": true
      }
    },
    "inputs": { "type": "array", "items": { "type": "string", "maxLength": 512 }, "maxItems": 256 },
    "outputs": { "type": "array", "items": { "type": "string", "maxLength": 512 }, "maxItems": 256 },
    "observability": { "type": "array", "items": { "type": "string", "maxLength": 128 }, "maxItems": 256 }
  },
  "additionalProperties": true
}
