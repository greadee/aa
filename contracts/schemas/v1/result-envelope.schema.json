{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/greadee/aa/contracts/schemas/v1/result-envelope.schema.json",
  "title": "aa-result-envelope",
  "x-contract-version": "1.0",
  "description": "The structured, untrusted output of an attempt. Authority accepts or rejects it; it is never canonical until accepted.",
  "type": "object",
  "required": ["contractVersion", "kind", "id", "attemptId", "assignmentId", "workPackageId", "status"],
  "properties": {
    "contractVersion": { "$ref": "common.schema.json#/$defs/contractVersion" },
    "kind": { "const": "result_envelope" },
    "id": { "$ref": "common.schema.json#/$defs/identifier" },
    "projectId": { "$ref": "common.schema.json#/$defs/identifier" },
    "attemptId": { "$ref": "common.schema.json#/$defs/identifier" },
    "assignmentId": { "$ref": "common.schema.json#/$defs/identifier" },
    "workPackageId": { "$ref": "common.schema.json#/$defs/identifier" },
    "status": { "enum": ["succeeded", "failed", "partial", "blocked", "cancelled"] },
    "summary": { "type": "string", "maxLength": 8192 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "id"],
        "properties": {
          "kind": { "type": "string", "maxLength": 64 },
          "id": { "$ref": "common.schema.json#/$defs/identifier" },
          "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "uri": { "type": "string", "maxLength": 2048 }
        },
        "additionalProperties": true
      },
      "maxItems": 1024
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "outcome"],
        "properties": {
          "name": { "type": "string", "maxLength": 512 },
          "outcome": { "enum": ["passed", "failed", "skipped", "error"] },
          "durationMs": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      },
      "maxItems": 4096
    },
    "telemetryRef": { "$ref": "common.schema.json#/$defs/reference" },
    "failure": {
      "type": "object",
      "properties": {
        "class": { "type": "string", "maxLength": 64 },
        "message": { "type": "string", "maxLength": 8192 },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "producedBy": { "$ref": "common.schema.json#/$defs/actor" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "additionalProperties": true
}
