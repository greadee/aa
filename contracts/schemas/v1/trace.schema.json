{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/greadee/aa/contracts/schemas/v1/trace.schema.json",
  "title": "aa-trace",
  "x-contract-version": "1.1",
  "description": "Bounded, redacted per-step evidence for one attempt, used by the learning and evaluation loop. It is operational evidence, not canonical history, and it is derived from observation and telemetry rather than being the observation protocol itself (owned by aa-obsv). Ordering is explicit via sequence; wall-clock time is never authoritative.",
  "type": "object",
  "required": ["contractVersion", "kind", "id", "attemptId", "steps"],
  "properties": {
    "contractVersion": { "$ref": "common.schema.json#/$defs/contractVersion" },
    "kind": { "const": "trace" },
    "id": { "$ref": "common.schema.json#/$defs/identifier" },
    "projectId": { "$ref": "common.schema.json#/$defs/identifier" },
    "attemptId": { "$ref": "common.schema.json#/$defs/identifier" },
    "assignmentId": { "$ref": "common.schema.json#/$defs/identifier" },
    "workPackageId": { "$ref": "common.schema.json#/$defs/identifier" },
    "redactionVersion": {
      "type": "string",
      "maxLength": 32,
      "description": "Version of the redaction policy applied before the trace was persisted."
    },
    "truncated": {
      "type": "boolean",
      "description": "True when steps were dropped to respect the bound; consumers must not treat a truncated trace as complete."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/traceStep" }
    },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "additionalProperties": true,
  "$defs": {
    "traceStep": {
      "type": "object",
      "required": ["sequence", "phase", "outcome"],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "description": "Explicit within-trace ordering; never the wall clock."
        },
        "at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "phase": {
          "enum": ["observe", "plan", "model", "tool", "edit", "test", "gate", "verify", "integrate"]
        },
        "actor": { "$ref": "common.schema.json#/$defs/actor" },
        "operation": { "type": "string", "maxLength": 128 },
        "target": { "$ref": "common.schema.json#/$defs/reference" },
        "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "outputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "outcome": { "enum": ["succeeded", "failed", "skipped", "blocked"] },
        "errorClass": { "type": "string", "maxLength": 128 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "tokens": {
          "type": "object",
          "properties": {
            "input": { "type": "integer", "minimum": 0 },
            "output": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "costUsd": { "type": "number", "minimum": 0 },
        "redacted": {
          "type": "boolean",
          "description": "True when content-bearing fields were removed or replaced with hashes."
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/reference" },
          "maxItems": 64
        }
      },
      "additionalProperties": true
    }
  }
}
