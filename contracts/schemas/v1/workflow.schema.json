{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/greadee/aa/contracts/schemas/v1/workflow.schema.json",
  "title": "aa-workflow",
  "x-contract-version": "1.0",
  "description": "A declarative, versioned, resumable workflow compiled by aa-toolbox and executed by aa-kernel.",
  "type": "object",
  "required": ["contractVersion", "kind", "id", "version", "steps"],
  "properties": {
    "contractVersion": { "$ref": "common.schema.json#/$defs/contractVersion" },
    "kind": { "const": "workflow" },
    "id": { "$ref": "common.schema.json#/$defs/identifier" },
    "name": { "type": "string", "maxLength": 256 },
    "version": { "type": "string", "maxLength": 64 },
    "description": { "type": "string", "maxLength": 8192 },
    "budget": { "$ref": "common.schema.json#/$defs/budget" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "additionalProperties": true,
  "$defs": {
    "step": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/identifier" },
        "kind": { "enum": ["task", "tool", "gate", "human_approval", "parallel", "conditional"] },
        "role": { "type": "string", "maxLength": 64 },
        "trade": { "type": "string", "maxLength": 64 },
        "toolId": { "$ref": "common.schema.json#/$defs/identifier" },
        "dependsOn": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/identifier" },
          "maxItems": 256
        },
        "retries": { "type": "integer", "minimum": 0, "maximum": 32 },
        "gates": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "maxItems": 64 },
        "onFailure": { "enum": ["fail", "retry", "skip", "compensate"] },
        "config": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    }
  }
}
