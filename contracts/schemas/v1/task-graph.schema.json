{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/greadee/aa/contracts/schemas/v1/task-graph.schema.json",
  "title": "aa-task-graph",
  "x-contract-version": "1.0",
  "description": "A versioned dependency graph over work packages.",
  "type": "object",
  "required": ["contractVersion", "kind", "id", "projectId", "nodes", "revision"],
  "properties": {
    "contractVersion": { "$ref": "common.schema.json#/$defs/contractVersion" },
    "kind": { "const": "task_graph" },
    "id": { "$ref": "common.schema.json#/$defs/identifier" },
    "projectId": { "$ref": "common.schema.json#/$defs/identifier" },
    "revision": { "type": "integer", "minimum": 0 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["workPackageId", "readiness"],
        "properties": {
          "workPackageId": { "$ref": "common.schema.json#/$defs/identifier" },
          "dependsOn": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/identifier" },
            "maxItems": 4096
          },
          "readiness": { "$ref": "common.schema.json#/$defs/stateReadiness" }
        },
        "additionalProperties": true
      }
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "additionalProperties": true
}
